{
  "version": "2.21",
  "children": [
    {
      "type": "frame",
      "id": "pgCover",
      "page": true,
      "name": "Cover",
      "layout": "none",
      "children": [
        {
          "type": "frame",
          "id": "cv",
          "name": "Cover",
          "x": 0,
          "y": -180,
          "width": 1600,
          "height": 900,
          "layout": "horizontal",
          "fill": "$bg/titlebar",
          "padding": 96,
          "gap": 72,
          "alignItems": "center",
          "theme": {
            "Mode": "Dark",
            "Stage": "Clean"
          },
          "cornerRadius": 24,
          "clip": true,
          "children": [
            {
              "type": "frame",
              "id": "cv_l",
              "name": "Text",
              "layout": "vertical",
              "width": 560,
              "gap": 22,
              "children": [
                {
                  "type": "ref",
                  "id": "cv_icon",
                  "ref": "c_app_icon"
                },
                {
                  "type": "text",
                  "id": "cv_t",
                  "name": "cv_t",
                  "content": "Git Graph",
                  "fontFamily": "$font/sans",
                  "fontSize": 64,
                  "fontWeight": 800,
                  "fill": "$text/primary",
                  "letterSpacing": -1.5
                },
                {
                  "type": "text",
                  "id": "cv_s",
                  "name": "cv_s",
                  "content": "The Neovim pane, grown into a desktop app. A commit graph you can read at a glance, with branches, changes, stashes and conflicts one click away.",
                  "fontFamily": "$font/sans",
                  "fontSize": 19,
                  "fontWeight": 400,
                  "fill": "$text/secondary",
                  "lineHeight": 1.5,
                  "width": "fill_container",
                  "textGrowth": "fixed-width"
                },
                {
                  "type": "frame",
                  "id": "cv_leg",
                  "name": "Legend",
                  "gap": 20,
                  "wrap": true,
                  "rowGap": 10,
                  "width": "fill_container",
                  "children": [
                    {
                      "type": "frame",
                      "id": "cv1",
                      "name": "HEAD",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "cv1_d",
                          "name": "dot",
                          "width": 10,
                          "height": 10,
                          "fill": "$ref/head"
                        },
                        {
                          "type": "text",
                          "id": "cv1_t",
                          "name": "cv1_t",
                          "content": "HEAD",
                          "fontFamily": "$font/sans",
                          "fontSize": "$text/md",
                          "fontWeight": 500,
                          "fill": "$text/secondary"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cv2",
                      "name": "Local",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "cv2_d",
                          "name": "dot",
                          "width": 10,
                          "height": 10,
                          "fill": "$ref/local"
                        },
                        {
                          "type": "text",
                          "id": "cv2_t",
                          "name": "cv2_t",
                          "content": "Local",
                          "fontFamily": "$font/sans",
                          "fontSize": "$text/md",
                          "fontWeight": 500,
                          "fill": "$text/secondary"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cv3",
                      "name": "Remote",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "cv3_d",
                          "name": "dot",
                          "width": 10,
                          "height": 10,
                          "fill": "$ref/remote"
                        },
                        {
                          "type": "text",
                          "id": "cv3_t",
                          "name": "cv3_t",
                          "content": "Remote",
                          "fontFamily": "$font/sans",
                          "fontSize": "$text/md",
                          "fontWeight": 500,
                          "fill": "$text/secondary"
                        }
                      ]
                    },
                    {
                      "type": "frame",
                      "id": "cv4",
                      "name": "Tag",
                      "gap": 8,
                      "alignItems": "center",
                      "children": [
                        {
                          "type": "ellipse",
                          "id": "cv4_d",
                          "name": "dot",
                          "width": 10,
                          "height": 10,
                          "fill": "$ref/tag"
                        },
                        {
                          "type": "text",
                          "id": "cv4_t",
                          "name": "cv4_t",
                          "content": "Tag",
                          "fontFamily": "$font/sans",
                          "fontSize": "$text/md",
                          "fontWeight": 500,
                          "fill": "$text/secondary"
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "cv_m",
                  "name": "cv_m",
                  "content": "Pages · Foundations → Components → Desktop → Neovim pane (source)\nThemes · Mode (Light / Dark) × Stage (Clean / Working / Conflict / Rebasing)",
                  "fontFamily": "$font/mono",
                  "fontSize": "$text/sm",
                  "fontWeight": 400,
                  "fill": "$text/muted",
                  "lineHeight": 1.7,
                  "width": "fill_container",
                  "textGrowth": "fixed-width"
                }
              ]
            },
            {
              "type": "frame",
              "id": "cv_r",
              "name": "Preview",
              "width": "fill_container",
              "height": "fill_container",
              "layout": "none",
              "clip": true,
              "cornerRadius": 12,
              "children": [
                {
                  "type": "ref",
                  "id": "cv_win",
                  "ref": "c_win_history",
                  "x": 0,
                  "y": 40
                }
              ]
            }
          ]
        }
