{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:event:default",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
